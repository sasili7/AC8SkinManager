{
  "version": "0.1.0-interface",
  "scope": "Offline Lua engine mocks, registry, author validator and entry-script checks; not a game integration result.",
  "checks": {
    "aircraft_filtering_and_independent_saved_selection": true,
    "selection_preserved_when_returning_to_aircraft": true,
    "leaving_preparation_closes_menu_and_does_not_apply": true,
    "aircraft_change_during_apply_rejected": true,
    "draft_skin_never_reaches_material_adapter": true,
    "failed_material_apply_never_saved": true,
    "failed_persistence_restores_previous_state_and_undo": true,
    "failed_switch_keeps_previous_applied_skin_highlight": true,
    "registry_accepts_same_local_id_for_different_aircraft": true,
    "registry_isolates_invalid_or_duplicate_author_manifests": true,
    "registry_rejects_cross_provider_and_duplicate_bindings": true,
    "runtime_gate_and_offline_gate_prevent_all_material_writes": true,
    "material_switch_creates_independent_instance_and_restores_original": true,
    "restore_failure_is_detected_by_actual_material_readback_and_rolled_back": true,
    "material_failure_rolls_back_all_changed_slots": true,
    "native_refresh_on_same_actor_is_detected_and_new_native_material_is_restored": true,
    "readback_detects_parameter_replacement_without_material_replacement": true,
    "switch_between_skins_with_disjoint_slots_clears_old_overrides_and_undo_restores_tracking": true,
    "asset_loading_failure_has_no_partial_material_changes": true,
    "native_registration_failure_prevents_material_writes": true,
    "native_registration_waiting_retries_and_success_is_cached": true,
    "newly_mounted_texture_loads_without_an_asset_registry_entry": true,
    "unregistered_texture_uses_explicit_package_export_without_soft_pointer": true,
    "native_button_grid_is_automatic_and_preserves_host_widget": true,
    "native_toggle_click_is_latched_once_between_polls": true,
    "native_checkbox_style_uses_reflected_fields_without_cpp_only_setter": true,
    "native_heading_inherits_game_section_font_and_size": true,
    "three_han_characters_and_ascii_labels_with_author_colors": true,
    "embedded_selection_without_viewport_flag_is_recognized": true,
    "hidden_parent_and_mission_aircraft_are_excluded": true,
    "multiple_display_aircraft_require_unique_recent_rendering": true,
    "model_transition_retains_panel_and_disables_stale_clicks": true,
    "weapon_and_native_skin_pages_hide_livery_even_with_visible_selection_parent": true,
    "legacy_config_cannot_mount_the_livery_panel_on_a_weapon_page": true,
    "detail_aircraft_resolves_overlap_and_excludes_wingman_text": true,
    "small_skin_sets_reserve_four_columns_with_larger_click_targets": true,
    "button_size_scales_with_the_actual_game_font_without_modifying_it": true,
    "flat_buttons_hide_native_checkbox_and_highlight_only_applied_skin_without_tooltips": true,
    "native_menu_unknown_mount_point_cleans_up_its_own_widgets": true,
    "author_validator_enforces_unicode_button_labels_and_hex_colors": true,
    "author_cli_validates_template_utf8_limits_and_rejects_invalid_namespace": true,
    "entry_script_registers_keys_and_probe_without_game_or_skin_mutation": true,
    "entry_dispatch_uses_explicit_process_event_and_records_context_gate": true,
    "entry_dispatch_failure_releases_pending_flag_for_retry": true,
    "entry_stalled_dispatch_does_not_queue_overlapping_uobject_actions": true,
    "entry_restore_retries_transient_failures_and_reapplies_after_native_refresh": true,
    "entry_roundtrip_diagnostic_restores_material_and_preserves_saved_choice": true,
    "fast_poll_updates_aircraft_restores_saved_skin_and_hides_without_hotkey": true,
    "automatic_restore_uses_backoff_and_manual_click_permits_immediate_retry": true,
    "background_and_input_dispatchers_do_not_overlap": true,
    "std_mode_does_not_reapply_materials_over_native_selection": true,
    "native_skin_authority_restores_only_owned_list_state_and_respects_existing_locks": true,
    "detached_valid_livery_panel_is_reattached_on_automatic_render": true,
    "all_shipped_lua_files_parse": true
  }
}